{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PMON (Debug)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:debug",
      "program": "${workspaceFolder}/bin/Debug/net10.0/win-x64/PMON.dll",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "PMON (Release exe)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build:release",
      "program": "${workspaceFolder}/dist/PMON.exe",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false
    }
  ]
}
