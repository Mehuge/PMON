<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PMON.ViewModels"
        xmlns:c="using:PMON.Controls"
        x:Class="PMON.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PMON - Process Monitor"
        Icon="/Assets/icon.png"
        Width="1480" Height="920"
        MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <DataTemplate x:Key="ChartCard" x:DataType="vm:ChartViewModel">
      <Border Classes="card" Padding="16,14,16,10" Margin="0,0,0,14">
        <StackPanel Spacing="2">
          <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Description}" Classes="muted" FontSize="12" />
          <c:TimeSeriesChart Model="{Binding}" Height="200" Margin="0,8,0,0" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="18,10">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <Image Source="/Assets/icon.png" Width="34" Height="34" />
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="PMON" FontSize="18" FontWeight="Bold" />
            <TextBlock Text="Process activity monitor" Classes="muted" FontSize="11" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Border Classes="card" Padding="16,6" MinWidth="130">
            <StackPanel>
              <TextBlock Text="SYSTEM CPU" Classes="section" Margin="0,0,0,2" />
              <TextBlock Text="{Binding CpuText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TealBrush}" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16,6" MinWidth="170">
            <StackPanel>
              <TextBlock Text="MEMORY" Classes="section" Margin="0,0,0,2" />
              <TextBlock Text="{Binding MemoryText}" FontSize="16" FontWeight="SemiBold" Foreground="#A78BFA" />
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="16,6" MinWidth="170">
            <StackPanel>
              <TextBlock Text="DISK" Classes="section" Margin="0,0,0,2" />
              <TextBlock Text="{Binding DiskText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Classes="ghost" Content="Open recording…" Click="OnOpenRecording" />
          <Button Classes="ghost" Content="About" Click="OnAbout" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="330,*" Margin="16,16,16,0">

      <!-- Sidebar -->
      <Border Grid.Column="0" Classes="card" Margin="0,0,16,0" Padding="16">
        <Grid RowDefinitions="Auto,Auto">

          <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="RECORDING" Classes="section" />
            <Button Classes="record" Classes.on="{Binding IsRecording}" Command="{Binding ToggleRecordingCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <Ellipse Width="11" Height="11" Fill="White" VerticalAlignment="Center" IsVisible="{Binding !IsRecording}" />
                <Rectangle Width="11" Height="11" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" RadiusX="2" RadiusY="2" IsVisible="{Binding IsRecording}" />
                <TextBlock Text="Start recording" IsVisible="{Binding !IsRecording}" />
                <TextBlock Text="Stop recording" IsVisible="{Binding IsRecording}" />
              </StackPanel>
            </Button>
            <TextBlock Text="{Binding RecordingStatus}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <TextBox Grid.Column="0" Text="{Binding RecordingFolder}" IsEnabled="{Binding !IsRecording}" PlaceholderText="Recording folder" />
              <Button Grid.Column="1" Classes="ghost" Content="Open" Command="{Binding OpenRecordingFolderCommand}" />
            </Grid>
            <CheckBox Content="Start recording when PMON launches" IsChecked="{Binding AutoRecord}" />
          </StackPanel>

          <StackPanel Grid.Row="1" Spacing="8" Margin="0,22,0,0">
            <TextBlock Text="TRACKING" Classes="section" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Grid.Column="0" Text="{Binding RulesSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Grid.Column="1" Classes="ghost" Content="Edit rules…" Click="OnEditRules" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
              <TextBlock Grid.Column="0" Text="Sample every" VerticalAlignment="Center" Classes="muted" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.IntervalOptions}" SelectedItem="{Binding SelectedInterval}" MinWidth="110">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:IntervalOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <CheckBox Content="Also record top CPU / memory / disk users" IsChecked="{Binding CaptureTop}" Margin="0,6,0,0"
                      ToolTip.Tip="Records the busiest processes outside your tracking rules, so a system-wide spike can be traced to its cause." />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" IsEnabled="{Binding CaptureTop}">
              <TextBlock Grid.Column="0" Text="Per category" VerticalAlignment="Center" Classes="muted" />
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:MainViewModel.TopCountOptions}" SelectedItem="{Binding SelectedTopCount}" MinWidth="110" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>

      <!-- Main area -->
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,10">
          <Border Grid.Column="0" Classes="card" CornerRadius="16" Padding="12,5" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource TealBrush}" IsVisible="{Binding IsLive}" />
              <Ellipse Width="9" Height="9" VerticalAlignment="Center" Fill="{StaticResource WarnBrush}" IsVisible="{Binding !IsLive}" />
              <TextBlock Text="{Binding SourceLabel}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Button Grid.Column="1" Classes="primary" Content="Jump to live" Margin="8,0,0,0" Command="{Binding GoLiveCommand}" IsVisible="{Binding CanGoLive}" />
          <Button Grid.Column="1" Classes="primary" Content="Back to live" Margin="8,0,0,0" Command="{Binding BackToLiveCommand}" IsVisible="{Binding !IsLive}" />
          <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis" />
          <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="90" Margin="0,0,12,0" IsVisible="{Binding IsBusy}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="ghost" Content="{Binding ProcessesLabel}" Margin="0,0,8,0">
              <Button.Flyout>
                <Flyout Placement="BottomEdgeAlignedRight">
                  <Grid RowDefinitions="Auto,*" Width="400" MaxHeight="560">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,8">
                      <TextBlock Grid.Column="0" Text="PROCESSES IN VIEW" Classes="section" Margin="0" VerticalAlignment="Center" />
                      <Button Grid.Column="1" Classes="icon" Content="All" Command="{Binding ShowAllProcessesCommand}" />
                      <Button Grid.Column="2" Classes="icon" Content="None" Command="{Binding HideAllProcessesCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="1" Classes="muted" TextWrapping="Wrap" FontSize="12" IsVisible="{Binding !HasProcesses}"
                               Text="No matching processes in this time range." />
                    <ScrollViewer Grid.Row="1" IsVisible="{Binding HasProcesses}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProcessGroupViewModel">
                            <Border Classes="proc" Classes.selected="{Binding IsSelected}" Margin="0,0,6,6">
                              <StackPanel>
                                <Button Classes="row" Command="{Binding ActivateCommand}">
                                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" Margin="10,6" ColumnSpacing="6">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                      <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" MinHeight="0" Padding="0" />
                                      <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                      <TextBlock Text="{Binding Subtitle}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Chevron}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasMany}" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Metrics}" FontSize="11" Margin="28,0,0,0" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding Activity}" Classes="muted" FontSize="11" Margin="28,0,0,0" TextWrapping="Wrap" />
                                  </Grid>
                                </Button>
                                <CheckBox Content="Chart each instance separately" IsChecked="{Binding IsSplit}" IsVisible="{Binding ShowInstances}"
                                          FontSize="12" Margin="16,0,6,6" />
                                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding ShowInstances}" Margin="16,0,6,6">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProcessItemViewModel">
                                      <Border Classes="instance" Classes.selected="{Binding IsSelected}" Margin="0,0,0,4">
                                        <Button Classes="row" Command="{Binding SelectCommand}">
                                          <StackPanel Margin="8,4" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                              <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" MinHeight="0" Padding="0" />
                                              <Ellipse Width="10" Height="10" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                              <TextBlock Text="{Binding Pid, StringFormat='PID {0}'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Metrics}" FontSize="11" Margin="28,0,0,0" />
                                            <TextBlock Text="{Binding Activity}" Classes="muted" FontSize="11" Margin="28,0,0,0" TextWrapping="Wrap" />
                                          </StackPanel>
                                        </Button>
                                      </Border>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Flyout>
              </Button.Flyout>
            </Button>
            <TextBlock Text="Time window" Classes="muted" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{x:Static vm:Viewport.SpanOptions}" SelectedItem="{Binding SelectedSpan}" MinWidth="110">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:SpanOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <Border Grid.Row="1" Classes="card" Padding="14,10" Margin="0,0,0,10" Background="#161F2C" IsVisible="{Binding !HasRules}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="Add one or more tracking rules to start tracking processes. System-wide metrics are always collected."
                       TextWrapping="Wrap" VerticalAlignment="Center" />
            <Button Grid.Column="1" Classes="primary" Content="Edit rules…" Click="OnEditRules" />
          </Grid>
        </Border>

        <TabControl Grid.Row="2" Padding="0,8,0,0" SelectedIndex="{Binding SelectedTab}">
          <TabItem Header="Overview">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding OverviewCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Process detail">
            <Grid RowDefinitions="Auto,Auto,*">
              <Button Grid.Row="0" x:Name="ProcessPicker" Classes="ghost" HorizontalAlignment="Left" MinWidth="320" Margin="0,0,0,10"
                      HorizontalContentAlignment="Stretch">
                <Button.Flyout>
                  <Flyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="wide">
                    <Grid RowDefinitions="Auto,Auto" Width="620">
                      <Grid Grid.Row="0" ColumnDefinitions="*,96,64,84,140" Margin="8,0,24,4" IsVisible="{Binding HasProcesses}">
                        <TextBlock Grid.Column="0" Text="PROCESS" Classes="section" Margin="0" />
                        <TextBlock Grid.Column="1" Text="INSTANCE" Classes="section" Margin="0" TextAlignment="Right" />
                        <TextBlock Grid.Column="2" Text="CPU" Classes="section" Margin="0" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="MEMORY" Classes="section" Margin="0" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="STATE" Classes="section" Margin="12,0,0,0" />
                      </Grid>
                      <ListBox Grid.Row="1" Classes="tasks" ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedProcess}"
                               MaxHeight="320" Padding="0" Background="Transparent" IsVisible="{Binding HasProcesses}"
                               ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnProcessPicked">
                        <ListBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:ProcessItemViewModel">
                            <Grid ColumnDefinitions="*,96,64,84,140" Margin="0,0,16,0">
                              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                <Ellipse Width="9" Height="9" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="1" Text="{Binding PidText}" Classes="muted" TextAlignment="Right" />
                              <TextBlock Grid.Column="2" Text="{Binding CpuText}" TextAlignment="Right" />
                              <TextBlock Grid.Column="3" Text="{Binding MemoryText}" TextAlignment="Right" />
                              <TextBlock Grid.Column="4" Text="{Binding State}" Classes="muted" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
                            </Grid>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <TextBlock Grid.Row="1" Classes="muted" Margin="8" IsVisible="{Binding !HasProcesses}"
                                 Text="No matching processes in this time range." />
                    </Grid>
                  </Flyout>
                </Button.Flyout>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Grid.Column="0" Text="Choose a process" Classes="muted" IsVisible="{Binding !HasSelection}" />
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSelection}">
                    <Ellipse Width="10" Height="10" Fill="{Binding SelectedProcess.Brush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedProcess.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedProcess.PidText}" Classes="muted" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="▾" Classes="muted" Margin="12,0,0,0" />
                </Grid>
              </Button>
              <Border Grid.Row="1" Classes="card" Padding="20" Margin="0,0,10,14" IsVisible="{Binding !HasSelection}">
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="Choose a process above to see all of its metrics together: CPU, memory, disk, threads, handles and window state." />
                </Border>
                <Border Grid.Row="1" Classes="card" Padding="18,14" Margin="0,0,10,14" IsVisible="{Binding HasSelection}">
                  <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Ellipse Width="12" Height="12" Fill="{Binding SelectedProcess.Brush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SelectedProcess.Name}" FontSize="18" FontWeight="Bold" />
                      <TextBlock Text="{Binding SelectedProcess.PidText}" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedProcess.Details}" FontSize="12" LineHeight="20" MinHeight="80" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" IsVisible="{Binding HasSelection}">
                  <StackPanel Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding DetailCharts}" ItemTemplate="{StaticResource ChartCard}" />
                    <Border Classes="card" Padding="16,14,16,10" Margin="0,0,0,14">
                      <StackPanel Spacing="2">
                        <TextBlock Text="Window state" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Classes="muted" FontSize="12" Text="Foreground, background, minimised and responsiveness over time." />
                        <c:StateTimelineChart Viewport="{Binding Viewport}" SelectedOnly="True" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="Top consumers">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Classes="card" Padding="18,14" Margin="0,0,10,14">
                <StackPanel Spacing="12">
                  <TextBlock Classes="muted" TextWrapping="Wrap" FontSize="12"
                             Text="The busiest processes that are NOT matched by your tracking rules, recorded with every sample. Use the hover cursor (or the timeline) to find what was responsible for a system-wide spike." />
                  <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="TOP CPU" Classes="section" Margin="0" />
                      <TextBlock Text="{Binding TopCpuText}" LineHeight="20" MinHeight="{Binding TopListHeight}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Text="TOP MEMORY" Classes="section" Margin="0" />
                      <TextBlock Text="{Binding TopMemoryText}" LineHeight="20" MinHeight="{Binding TopListHeight}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Text="TOP DISK" Classes="section" Margin="0" />
                      <TextBlock Text="{Binding TopDiskText}" LineHeight="20" MinHeight="{Binding TopListHeight}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding TopCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
              </ScrollViewer>
            </Grid>
          </TabItem>
          <TabItem Header="CPU">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding CpuCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Memory">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding MemoryCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Disk I/O">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DiskCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Handles &amp; GUI">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding ResourceCharts}" ItemTemplate="{StaticResource ChartCard}" Margin="0,0,10,0" />
            </ScrollViewer>
          </TabItem>
          <TabItem Header="Activity">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <Border Classes="card" Padding="16,14,16,10" Margin="0,0,10,14">
                <StackPanel Spacing="2">
                  <TextBlock Text="Process activity" FontSize="15" FontWeight="SemiBold" />
                  <TextBlock Classes="muted" FontSize="12" Text="Foreground / background / minimised state and responsiveness over time. Hover a row for window details." />
                  <c:StateTimelineChart Viewport="{Binding Viewport}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>
    </Grid>

    <!-- Timeline -->
    <Border Grid.Row="2" Classes="card" Margin="16" Padding="14,10,14,8">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="TIMELINE" Classes="section" Margin="0" />
          <TextBlock Grid.Column="1" Classes="muted" FontSize="11"
                     Text="Drag the highlighted window, or click anywhere, to move through time  ·  Ctrl+wheel on a chart zooms  ·  drag a chart to pan" />
        </Grid>
        <c:TimelineBar Viewport="{Binding Viewport}" Height="76" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
